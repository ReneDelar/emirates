---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo-white.png';
import { useI18n } from '../i18n';
const { t, path } = useI18n(Astro.url);
const navLinks = [
  { label: t.nav.home, href: path('/') },
  { label: t.nav.about, href: path('/about') },
  { label: t.nav.regions, href: path('/fishing-regions') },
  { label: t.nav.yachts, href: path('/yacht-rental') },
  { label: t.nav.excursions, href: path('/excursions') },
  { label: t.nav.contacts, href: path('/contacts') },
];
const excursions = Object.entries(t.excursionLinks).map(([id, label]) => ({ label, href: path(`/excursions#${id}`) }));
const link = 'text-[#9fb4c6] no-underline text-[14px] leading-[2.1] transition-colors duration-150 hover:text-white';
const head = 'text-white text-[14px] tracking-[.04em] mb-3 uppercase';
---

<footer class="bg-navy text-[#9fb4c6]">
  <div class="container pt-14 grid grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-10 max-[860px]:grid-cols-2 max-[860px]:gap-[30px] max-[520px]:grid-cols-1">
    <div>
      <div class="flex items-center mb-4">
        <Image src={logoWhite} alt="Emirates Fishing Tour" class="h-[30px] w-auto block" />
      </div>
      <p class="text-[14.5px] leading-[1.7] max-w-[300px]">{t.footer.about}</p>
    </div>

    <div class="flex flex-col">
      <h4 class={head}>{t.footer.navigation}</h4>
      {navLinks.map((l) => <a class={link} href={l.href}>{l.label}</a>)}
    </div>

    <div class="flex flex-col">
      <h4 class={head}>{t.footer.excursions}</h4>
      {excursions.map((s) => <a class={link} href={s.href}>{s.label}</a>)}
    </div>

    <div class="flex flex-col">
      <h4 class={head}>{t.footer.contact}</h4>
      <a href="tel:+971000000000" class="text-[#cfe0ee] no-underline font-bold text-base mb-1.5">+971 00 000 0000</a>
      <a class={link} href="https://wa.me/971000000000">{t.footer.whatsapp}</a>
      <a class={link} href="mailto:info@emiratesfishingtour.com">info@emiratesfishingtour.com</a>
      <span class="text-[#9fb4c6] text-[14px] leading-[2]">{t.footer.location}</span>
    </div>
  </div>

  <div class="container mt-[38px] pt-[18px] pb-[18px] border-t border-white/[.12] flex flex-wrap justify-between gap-2.5">
    <p class="m-0 text-[13.5px]">&copy; 2024 Emirates Fishing Tour &middot; {t.footer.rights}</p>
    <p class="m-0 text-[13.5px]">{t.footer.built} &middot; emiratesfishingtour.com</p>
  </div>
</footer>
